	/// 
	/// SUMX(
	/// fPedido,
	/// fPedido[VLR_BRUTO] -
	/// fPedido[VLR_COFINS] -
	/// fPedido[VLR_ICMS] -
	/// fPedido[VLR_IPI] -
	/// fPedido[VLR_PIS]
	/// )
	measure 'VALOR LIQUIDO PDV' = ```
			
			SUMX(
			    fPedido,
			    fPedido[VLR_BRUTO] - 
			    fPedido[VLR_COFINS] - 
			    fPedido[VLR_ICMS] - 
			    fPedido[VLR_IPI] - 
			    fPedido[VLR_PIS]
			)
			```
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: cfbe871f-cfc3-4d43-9dd1-e63d3d29d0f2

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

