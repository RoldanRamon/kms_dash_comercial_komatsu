	/// 
	/// IF(
	/// [% Faturamento Pedido Qtde Linhas] <> 1,
	/// DIVIDE([Faturamento Pedidos],[VALOR LIQUIDO PDV],0),
	/// 1)
	measure '% Faturamento Pedido Qtde Linhas' = ```
			
			DIVIDE(COUNTROWS(fVendasPedidoMes),COUNTROWS(fPedido),0)
			```
		formatString: 0.00%;-0.00%;0.00%
